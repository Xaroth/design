---
import Harness from '../layouts/Harness.astro'
import Pagination from '@xaroth.nl/design/astro/pagination'

const href = '#page-{page}'
---

<Harness title="Pagination">
  {() => (
    <div style="display: grid; gap: 32px; padding: 0 32px">
      <Pagination page={1} pages={8} href={href} />
      <Pagination page={2} pages={8} href={href} align="start" />
      <Pagination page={5} pages={10} href={href} ends align="start" />
      <Pagination page={10} pages={10} href={href} ends align="start" />
    </div>
  )}
</Harness>
