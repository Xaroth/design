---
import Harness from '../layouts/Harness.astro'
import { Button } from '@xaroth.nl/design/astro'
---

<Harness title="Button">
  {() => (
    <div style="padding: 0 32px">
          <div style="display: grid; gap: 12px; margin-top: 16px">
            {['default', 'danger', 'warning', 'success'].map((tone) => (
              <p style="display: flex; gap: 12px; flex-wrap: wrap">
                <Button tone={tone as never}>Primary</Button>
                <Button tone={tone as never} variant="secondary">Secondary</Button>
                <Button tone={tone as never} variant="tertiary">Tertiary</Button>
              </p>
            ))}
            {(['primary', 'secondary', 'tertiary'] as const).map((variant) => (
              <p style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center">
                <Button variant={variant} size="sm">Small</Button>
                <Button variant={variant}>Medium</Button>
                <Button variant={variant} size="lg">Large</Button>
                <Button variant={variant} disabled>Disabled</Button>
                <Button variant={variant} loading>Loading</Button>
              </p>
            ))}
            <p style="display: flex; gap: 12px; flex-wrap: wrap">
              <Button size="sm">Small</Button>
              <Button size="lg" href="#">Large link <span slot="end">→</span></Button>
              <Button loading>Loading</Button>
              <Button disabled>Disabled</Button>
              <Button href="#" disabled>Disabled link</Button>
            </p>
            <Button fullWidth variant="secondary">Full width</Button>
          </div>
        
    </div>
  )}
</Harness>
