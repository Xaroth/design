---
// Lists every harness page, so a new part shows up without editing this file.
const pages = Object.keys(import.meta.glob('./*.astro'))
  .map((path) => path.slice(2, -'.astro'.length))
  .filter((name) => name !== 'index')
  .sort()
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Harness</title>
  </head>
  <body style="font: 16px/1.6 system-ui, sans-serif; padding: 32px; background: #111; color: #eee">
    <h1>Harness</h1>
    <p>Every part, rendered once per theme.</p>
    <ul>
      {
        pages.map((name) => (
          <li>
            <a href={`/${name}`} style="color: #9cf">{name}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
