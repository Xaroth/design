---
import Harness from '../layouts/Harness.astro'
import type { TableColumn } from '@xaroth.nl/design/parts'
import { Checkbox, CheckboxGroup, Container, Field, FilterLayout, FilterPanel, Input, Select, Switch, Table } from '@xaroth.nl/design/astro'

const factions = ['All factions', 'Amarr Empire', 'Caldari State', 'Gallente Federation', 'Minmatar Republic']
const categories = ['Combat', 'Industry', 'Exploration']
const columns: TableColumn[] = [
  { key: 'name', label: 'Achievement' },
  { key: 'faction', label: 'Faction' },
  { key: 'category', label: 'Category' },
  { key: 'reward', label: 'Reward LP', numeric: true },
]
const rows = [
  { name: 'Wardec Veteran', faction: 'Amarr Empire', category: 'Combat', reward: '25,000' },
  { name: 'Sovereign Hauler', faction: 'Caldari State', category: 'Industry', reward: '4,800' },
  { name: 'Sisters of Mercy', faction: 'Gallente Federation', category: 'Exploration', reward: '10,000' },
  { name: 'Tribal Liberator', faction: 'Minmatar Republic', category: 'Combat', reward: '1,250' },
]
const layouts = [
  { key: 'switch', position: 'top', switchable: true, collapsible: true },
  { key: 'side', position: 'side', switchable: false, collapsible: false },
] as const
---

<Harness title="Filters">
  {(theme: string) => (
    <Container style="display: grid; gap: 64px">
      {layouts.map(({ key, position, switchable, collapsible }) => (
        <FilterLayout position={position} switchable={switchable} collapsible={collapsible} activeCount={2} id={`${theme}-${key}`}>
          <FilterPanel slot="filters" aria-label="Filter achievements" onsubmit="return false">
            <Field id={`${theme}-${key}-search`} label="Search">
              <Input type="search" placeholder="Achievement name">
                <svg slot="start" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="M20 20l-4-4"></path>
                </svg>
              </Input>
            </Field>
            <Field id={`${theme}-${key}-faction`} label="Faction">
              <Select>{factions.map((f) => <option>{f}</option>)}</Select>
            </Field>
            <CheckboxGroup id={`${theme}-${key}-category`} legend="Category" orientation="horizontal">
              {categories.map((c, i) => <Checkbox name="category" value={c} checked={i < 2}>{c}</Checkbox>)}
            </CheckboxGroup>
            <Switch name="hide">Hide completed</Switch>
          </FilterPanel>
          <Table columns={columns} rows={rows} label="Achievements" />
        </FilterLayout>
      ))}
    </Container>
  )}
</Harness>
