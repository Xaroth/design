---
import Harness from '../layouts/Harness.astro'
import { Timeline } from '@xaroth.nl/design/astro'

const items = [
  {
    date: '2026',
    title: 'eve-online.tools',
    text: 'Rebuilt the tool collection on typed ESI and a pinned SDE.',
    current: true,
  },
  { date: '2024', title: 'Fanfest schedule', text: 'Shipped the unofficial Fanfest schedule site.' },
  { date: '2019', title: 'Joined CCP Games', text: 'Started working on EVE Online services.' },
  { date: '2006-05-06', title: 'Undocked', text: 'First login to New Eden. Lost a Rifter within the hour.' },
]
---

<Harness title="Timeline harness">
  {(theme: string) => (
    <div style="padding: 32px">
          <h2 style="margin-bottom: 24px">{theme}</h2>
          <div style="max-width: 48rem">
            <Timeline items={items} />
          </div>
    </div>
  )}
</Harness>
