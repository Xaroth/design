---
import Harness from '../layouts/Harness.astro'
import { Badge } from '@xaroth.nl/design/astro'

const tones = [
  ['default', 'Locked'],
  ['info', 'Beta'],
  ['success', 'Stable'],
  ['warning', 'Experimental'],
  ['danger', 'Offline'],
] as const
---

<Harness title="Badge">
  {() => (
    <div style="padding: 32px">
          <p style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px">
            {tones.map(([tone, label]) => (
              <Badge tone={tone}>{label}</Badge>
            ))}
          </p>
    </div>
  )}
</Harness>
