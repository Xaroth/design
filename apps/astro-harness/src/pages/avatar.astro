---
import Harness from '../layouts/Harness.astro'
import Avatar from '@xaroth.nl/design/astro/avatar'

const sizes = ['sm', 'md', 'lg', 'xl'] as const
const photo = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x2="0" y2="1"><stop offset="0" stop-color="#6b8fa3"/><stop offset="1" stop-color="#2d3b44"/></linearGradient></defs><rect width="100" height="100" fill="url(#g)"/><circle cx="50" cy="40" r="18" fill="#d9c7ad"/><path d="M14 100c4-24 20-34 36-34s32 10 36 34z" fill="#1f2a31"/></svg>',
)}`
---

<Harness title="Avatar">
  {() => (
    <div style="padding: 0 32px; display: grid; gap: 24px">
      <p style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap">
        {sizes.map((size) => <Avatar name="Xaroth" size={size} />)}
      </p>
      <p style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap">
        {sizes.map((size) => <Avatar name="Xaroth Brook" src={photo} size={size} />)}
      </p>
      <div style="display: flex; gap: 16px; align-items: center; max-width: 480px">
        <Avatar name="Xaroth Brook" initials="X" alt="" />
        <div>
          <p style="font-weight: 600">Xaroth Brook</p>
          <p class="x-muted">Software engineer</p>
        </div>
      </div>
    </div>
  )}
</Harness>
