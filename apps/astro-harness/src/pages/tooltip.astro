---
import Harness from '../layouts/Harness.astro'
import { Button, Icon, Tooltip } from '@xaroth.nl/design/astro'
---

<Harness title="Tooltip">
  {(theme: string) => (
    <div style="padding: 72px 32px 80px 120px; display: flex; gap: 48px; flex-wrap: wrap; align-items: flex-start">
      <Tooltip id={`${theme}-scopes`} text="Two scopes: achievements and standings." open>
        <Button variant="secondary" size="sm">Scopes</Button>
      </Tooltip>
      <Tooltip id={`${theme}-range`} text="Cyno range 5.0 LY with Jump Drive Calibration V" placement="bottom" open>
        <Button variant="secondary" size="sm">Bottom</Button>
      </Tooltip>
      <Tooltip id={`${theme}-hover`} text="Shown on hover and keyboard focus.">
        <Button variant="tertiary" size="sm">Hover me</Button>
      </Tooltip>
      <Tooltip id={`${theme}-icon`} text="Cached for 5 minutes.">
        <button type="button" aria-label="Cache info" style="display: inline-grid; place-items: center; width: 36px; height: 36px; color: var(--x-color-text-muted); background: none; border: 0">
          <Icon name="info" size={20} />
        </button>
      </Tooltip>
      <div style="width: 100%; display: flex; justify-content: space-between; align-items: center">
        <Tooltip id={`${theme}-left`} text="Fleet roster" placement="left" open>
          <Button variant="secondary" size="sm">Left</Button>
        </Tooltip>
        <Tooltip id={`${theme}-right`} text="Fleet roster" placement="right" open>
          <Button variant="secondary" size="sm">Right</Button>
        </Tooltip>
        <Tooltip id={`${theme}-side`} text="Flips to the left at the viewport edge." placement="right">
          <button type="button" aria-label="Fleet" style="display: inline-grid; place-items: center; width: 36px; height: 36px; color: var(--x-color-text-muted); background: none; border: 0">
            <Icon name="info" size={20} />
          </button>
        </Tooltip>
      </div>
      <div data-test="scroller" style="overflow: auto; width: 100%; padding: 8px; display: flex; justify-content: flex-end">
        <Tooltip id={`${theme}-edge`} text="Remove this pilot from the fleet roster and all of their scopes.">
          <Button variant="secondary" size="sm">Remove</Button>
        </Tooltip>
      </div>
    </div>
  )}
</Harness>
