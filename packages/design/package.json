      "source": "./src/components/empty-state/empty-state.astro",
      "default": "./dist/components/empty-state/empty-state.astro"
    },
    "./astro/checkbox": {
      "source": "./src/components/field/checkbox.astro",
      "default": "./dist/components/field/checkbox.astro"
    },
    "./astro/field": {
      "source": "./src/components/field/field.astro",
      "default": "./dist/components/field/field.astro"
    },
    "./astro/input": {
      "source": "./src/components/field/input.astro",
      "default": "./dist/components/field/input.astro"
    },
    "./astro/radio-group": {
      "source": "./src/components/field/radio-group.astro",
      "default": "./dist/components/field/radio-group.astro"
    },
    "./astro/radio": {
      "source": "./src/components/field/radio.astro",
      "default": "./dist/components/field/radio.astro"
    },
    "./astro/select": {
      "source": "./src/components/field/select.astro",
      "default": "./dist/components/field/select.astro"
    },
    "./astro/switch": {
      "source": "./src/components/field/switch.astro",
      "default": "./dist/components/field/switch.astro"
    },
    "./astro/textarea": {
      "source": "./src/components/field/textarea.astro",
