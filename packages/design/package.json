{
  "name": "@xaroth.nl/design",
  "version": "0.3.1",
  "description": "Shared design system for xaroth.nl and eve-online.tools: CSS core, themes, Astro and React parts.",
  "license": "MIT",
  "author": "Xaroth Brook <xaroth+github@xaroth.nl>",
  "keywords": [
    "astro",
    "css",
    "design-system",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    "./astro": {
      "source": "./src/astro.ts",
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./parts": {
      "source": "./src/parts.ts",
      "types": "./dist/parts.d.ts",
      "import": "./dist/parts.js",
      "default": "./dist/parts.js"
    },
    "./themes/*.css": {
      "source": "./src/styles/themes/*.scss",
      "default": "./dist/themes/*.css"
    },
    "./themes.css": {
      "source": "./src/styles/themes.scss",
      "default": "./dist/themes.css"
    },
    "./all.css": {
      "source": "./src/styles/all.scss",
      "default": "./dist/all.css"
    },
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xaroth/design.git",
    "directory": "packages/design"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "node scripts/generate.ts && node scripts/build.ts && tsc -p tsconfig.build.json && node scripts/postbuild.ts",
    "typecheck": "node scripts/generate.ts --check && tsc --noEmit && astro check"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "astro": "^7",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "astro": "catalog:",
    "react": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "exports": {
      "./astro": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "default": "./dist/react.js"
      },
      "./parts": {
        "types": "./dist/parts.d.ts",
        "import": "./dist/parts.js",
        "default": "./dist/parts.js"
      },
      "./themes/*.css": "./dist/themes/*.css",
      "./themes.css": "./dist/themes.css",
      "./all.css": "./dist/all.css",
      "./scss/*": "./dist/scss/*"
    }
  }
}
