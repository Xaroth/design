    "./astro/prose": {
      "source": "./src/components/prose/prose.astro",
      "default": "./dist/components/prose/prose.astro"
    },
    "./astro/stat-group": {
      "source": "./src/components/stat/stat-group.astro",
      "default": "./dist/components/stat/stat-group.astro"
    },
    "./astro/stat": {
      "source": "./src/components/stat/stat.astro",
      "default": "./dist/components/stat/stat.astro"
    },
    "./astro/table": {
      "source": "./src/components/table/table.astro",
      "default": "./dist/components/table/table.astro"
    },
    "./astro/tabs": {
      "source": "./src/components/tabs/tabs.astro",
      "default": "./dist/components/tabs/tabs.astro"
    },
    "./astro/tag": {
      "source": "./src/components/tag/tag.astro",
      "default": "./dist/components/tag/tag.astro"
    },
    "./astro/timeline": {
      "source": "./src/components/timeline/timeline.astro",
      "default": "./dist/components/timeline/timeline.astro"
    },
    "./astro/tooltip": {
      "source": "./src/components/tooltip/tooltip.astro",
      "default": "./dist/components/tooltip/tooltip.astro"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xaroth/design.git",
    "directory": "packages/design"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "node scripts/generate.ts && node scripts/build.ts && tsc -p tsconfig.build.json && node scripts/postbuild.ts",
    "typecheck": "node scripts/generate.ts --check && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0"
  },
  "peerDependencies": {
    "astro": ">=7",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:"
  }
}
