    },
    "./astro/pagination": {
      "source": "./src/components/pagination/pagination.astro",
      "default": "./dist/components/pagination/pagination.astro"
    },
    "./astro/panel": {
      "source": "./src/components/panel/panel.astro",
      "default": "./dist/components/panel/panel.astro"
    },
    "./astro/progress": {
      "source": "./src/components/progress/progress.astro",
      "default": "./dist/components/progress/progress.astro"
    },
    "./astro/code-block": {
      "source": "./src/components/prose/code-block.astro",
      "default": "./dist/components/prose/code-block.astro"
