      "source": "./src/components/button/button.astro",
      "default": "./dist/components/button/button.astro"
    },
    "./astro/card": {
      "source": "./src/components/card/card.astro",
      "default": "./dist/components/card/card.astro"
    },
    "./astro/description-list": {
      "source": "./src/components/description-list/description-list.astro",
      "default": "./dist/components/description-list/description-list.astro"
    },
