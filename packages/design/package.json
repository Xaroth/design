{
  "name": "@xaroth.nl/design",
  "version": "0.1.0",
  "description": "Shared design system for xaroth.nl and eve-online.tools: CSS core, themes, Astro and React parts.",
  "license": "MIT",
  "author": "Xaroth Brook <xaroth+github@xaroth.nl>",
  "keywords": [
    "astro",
    "css",
    "design-system",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    "./themes/xaroth.css": {
      "source": "./src/styles/themes/xaroth.scss",
      "default": "./dist/themes/xaroth.css"
    },
    "./themes/eve-online.css": {
      "source": "./src/styles/themes/eve-online.scss",
      "default": "./dist/themes/eve-online.css"
    },
    "./themes.css": {
      "source": "./src/styles/themes.scss",
      "default": "./dist/themes.css"
    },
    "./all.css": {
      "source": "./src/styles/all.scss",
      "default": "./dist/all.css"
    },
    "./scss/*": "./src/styles/*",
    "./astro": {
      "source": "./src/astro.ts",
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./parts": {
      "source": "./src/parts.ts",
      "types": "./dist/parts.d.ts",
      "import": "./dist/parts.js"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./astro/alert": {
      "source": "./src/components/alert/alert.astro",
      "default": "./dist/components/alert/alert.astro"
    },
    "./astro/avatar": {
      "source": "./src/components/avatar/avatar.astro",
      "default": "./dist/components/avatar/avatar.astro"
    },
    "./astro/badge": {
