---
import type { HTMLAttributes } from 'astro/types'
import { choiceClass } from '../parts/field.ts'

type Props = Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'role'> & {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<label class={choiceClass('checkbox', { className })}>
  <input class="x-checkbox__input" type="checkbox" {...rest} />
  <span class="x-checkbox__label"><slot /></span>
</label>
