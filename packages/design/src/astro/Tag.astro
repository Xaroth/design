---
import type { HTMLAttributes } from 'astro/types'
import { tagClass, tagState, type TagOptions } from '../parts/tag.ts'

type Props = Omit<HTMLAttributes<'a'>, 'class'> &
  Omit<TagOptions, 'className'> & {
    class?: string
    href?: string
  }

// `slot` is how a parent places this tag; it is not an attribute of the tag.
const { active, href, class: className, slot: _slot, ...rest } = Astro.props
const { tag: El, attrs } = tagState({ href, active })
---

<El class={tagClass({ active, className })} {...attrs} {...rest}><slot /></El>
