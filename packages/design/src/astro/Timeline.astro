---
import type { HTMLAttributes } from 'astro/types'
import {
  timelineClass,
  timelineHeading,
  timelineItemClass,
  type TimelineEntry,
  type TimelineHeadingLevel,
} from '../parts/timeline.ts'

type Props = Omit<HTMLAttributes<'ol'>, 'class'> & {
  class?: string
  items: TimelineEntry[]
  headingLevel?: TimelineHeadingLevel
}

const { items, headingLevel, class: className, ...rest } = Astro.props
const Heading = timelineHeading(headingLevel)
---

<ol class={timelineClass({ className })} {...rest}>
  {
    items.map(({ date, datetime, title, text, current }) => (
      <li class={timelineItemClass({ current })}>
        {datetime ? (
          <time class="x-timeline__date" datetime={datetime}>
            {date}
          </time>
        ) : (
          <span class="x-timeline__date">{date}</span>
        )}
        <div class="x-timeline__body">
          <Heading class="x-timeline__title">{title}</Heading>
          {text && <p class="x-timeline__text">{text}</p>}
        </div>
      </li>
    ))
  }
</ol>
