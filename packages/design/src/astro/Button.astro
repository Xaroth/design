---
import type { HTMLAttributes } from 'astro/types'
import { buttonClass, type ButtonSize, type ButtonVariant } from '../parts/button.ts'

type Props = (HTMLAttributes<'button'> | HTMLAttributes<'a'>) & {
  variant?: ButtonVariant
  size?: ButtonSize
  href?: string
}

const { variant, size, class: className, href, ...rest } = Astro.props
const classes = buttonClass({ variant, size, className: className ?? undefined })
---

{
  href ? (
    <a class={classes} href={href} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} type="button" {...rest}>
      <slot />
    </button>
  )
}
