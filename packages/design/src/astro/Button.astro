---
import type { HTMLAttributes } from 'astro/types'
import { buttonClass, buttonState, type ButtonOptions } from '../parts/button.ts'

type Props = Omit<HTMLAttributes<'button'>, 'class'> &
  Omit<ButtonOptions, 'className'> & {
    class?: string
    href?: string
  }

const { variant, tone, size, fullWidth, loading, disabled, class: className, href, type = 'button', ...rest } =
  Astro.props
const classes = buttonClass({ variant, tone, size, fullWidth, loading, className })
const { tag: Tag, attrs } = buttonState({ href, disabled: Boolean(disabled), loading })
const typeAttr = Tag === 'button' ? { type } : {}
---

<Tag class={classes} {...typeAttr} {...attrs} {...rest}>
  {
    Astro.slots.has('start') && (
      <span class="x-button__start">
        <slot name="start" />
      </span>
    )
  }
  <span class="x-button__label"><slot /></span>
  {
    Astro.slots.has('end') && (
      <span class="x-button__end">
        <slot name="end" />
      </span>
    )
  }
  {loading && <span class="x-button__spinner" aria-hidden="true" />}
</Tag>
