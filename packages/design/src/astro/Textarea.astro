---
import type { HTMLAttributes } from 'astro/types'
import { textareaClass } from '../parts/field.ts'

type Props = Omit<HTMLAttributes<'textarea'>, 'class' | 'value'> & {
  /** Initial text. The default slot works too. */
  value?: string
  defaultValue?: string
  class?: string
}

const { value, defaultValue, class: className, ...rest } = Astro.props
const text = value ?? defaultValue
---

{
  text === undefined ? (
    <textarea class={textareaClass({ className })} {...rest}><slot /></textarea>
  ) : (
    <textarea class={textareaClass({ className })} {...rest}>{text}</textarea>
  )
}
