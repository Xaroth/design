---
import './tooltip.scss'
import type { HTMLAttributes } from 'astro/types'
import { firstOnPage } from '../../html.ts'
import { describeTrigger, tooltipClass, tooltipEscapeScript, tooltipId, type TooltipOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'span'>, 'class' | 'id'> &
  Omit<TooltipOptions, 'className'> & {
    class?: string
    /** Base for the tooltip id that the trigger's aria-describedby points at. Unique per page. */
    id: string
    /** Short hint. Never the only place for information needed to use the page. */
    text: string
  }

const { id, text, placement, open, class: className, slot: _slot, ...rest } = Astro.props
const trigger = describeTrigger(await Astro.slots.render('default'), id)
const withScript = firstOnPage(Astro.request, 'x-tooltip')
---

<span {...{ ...rest, class: tooltipClass({ placement, open, className }) }}>
  <Fragment set:html={trigger} />
  <span class="x-tooltip__bubble" role="tooltip" id={tooltipId(id)}>{text}</span>
</span>
{withScript && <script is:inline set:html={tooltipEscapeScript} />}
