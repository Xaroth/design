---
import './table.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  tableCellClass,
  tableCellSlot,
  tableClass,
  tableWrapClass,
  type TableCell,
  type TableColumn,
  type TableLabel,
  type TableOptions,
  type TableRow,
} from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'aria-label' | 'aria-labelledby'> &
  Omit<TableOptions, 'className'> &
  TableLabel & {
    class?: string
    columns: TableColumn[]
    /** Plain values. For markup, use a `cell-<rowIndex>-<key>` slot or a default slot function (see below). */
    rows: TableRow[]
    caption?: string
    stickyHeader?: boolean
  }

const {
  columns,
  rows,
  caption,
  density,
  striped,
  hover,
  stickyHeader,
  label,
  class: className,
  slot: _slot,
  ...rest
} = Astro.props
const attrs = { ...rest, role: 'region' as const, tabindex: '0', 'aria-label': label }

// Cell markup, first match wins: the named slot `cell-<rowIndex>-<key>` (static markup), then a default slot
// function `(cell: TableCell) => markup`, which is called per cell; rendering nothing keeps the plain value.
// A default slot of plain markup is ignored.
const renderCell = async (cell: TableCell): Promise<string | undefined> => {
  const args = [cell]
  const probe = { called: false }
  // Astro cannot tell a slot function from plain markup; only a function spreads the arguments it is given.
  Object.defineProperty(args, Symbol.iterator, {
    value: function* () {
      probe.called = true
      yield cell
    },
  })
  const html = await Astro.slots.render('default', args)
  return probe.called ? html : undefined
}
let hasRenderer = Astro.slots.has('default')
const slotted = new Map<string, string>()
for (const [rowIndex, row] of rows.entries()) {
  for (const column of columns) {
    const name = tableCellSlot(rowIndex, column.key)
    let html = Astro.slots.has(name) ? await Astro.slots.render(name) : undefined
    if (html === undefined && hasRenderer) {
      const rendered = await renderCell({ row, rowIndex, column, value: row[column.key] })
      hasRenderer = rendered !== undefined
      html = rendered?.trim() || undefined
    }
    if (html !== undefined) {
      slotted.set(name, html)
    }
  }
}
---

<div {...attrs} class={tableWrapClass({ stickyHeader, className })}>
  <table class={tableClass({ density, striped, hover })}>
    {caption && <caption class="x-table__caption">{caption}</caption>}
    <thead>
      <tr>
        {
          columns.map((column) => (
            <th
              class={tableCellClass(column, 'head')}
              scope="col"
              style={column.width ? `width:${column.width}` : undefined}
            >
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, i) => (
          <tr>
            {columns.map((column) => {
              const html = slotted.get(tableCellSlot(i, column.key))
              return (
                <td class={tableCellClass(column, 'body')}>
                  {html !== undefined ? <Fragment set:html={html} /> : row[column.key]}
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
