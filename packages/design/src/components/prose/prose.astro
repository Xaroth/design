---
import './prose.scss'
import type { HTMLAttributes } from 'astro/types'
import { proseClass } from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  class?: string
  as?: 'div' | 'article' | 'section' | 'main'
}

const { as: Tag = 'div', class: className, slot: _slot, ...rest } = Astro.props
---

<Tag {...rest} class={proseClass({ className })}><slot /></Tag>
