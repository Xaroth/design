---
import './field.scss'
import type { HTMLAttributes } from 'astro/types'
import { choiceGroupAttrs, choiceGroupClass, fieldIds, type ChoiceGroupOrientation } from './index.ts'

type Props = Omit<HTMLAttributes<'fieldset'>, 'class' | 'id' | 'role'> & {
  /** Help and error text get `${id}-help` and `${id}-error`. */
  id: string
  legend?: string
  description?: string
  error?: string
  required?: boolean
  orientation?: ChoiceGroupOrientation
  class?: string
}

const { id, legend, description, error, required, orientation, class: className, ...rest } = Astro.props
const hasLegend = Boolean(legend) || Astro.slots.has('legend')
const hasDescription = Boolean(description) || Astro.slots.has('description')
const hasError = Boolean(error) || Astro.slots.has('error')
const ids = fieldIds(id)
---

<fieldset
  class={choiceGroupClass({ orientation, invalid: hasError, className })}
  {...choiceGroupAttrs({ id, hasDescription, hasError, required, kind: 'checkbox' })}
  {...rest}
>
  {
    hasLegend && (
      <legend class="x-choice-group__legend">
        {Astro.slots.has('legend') ? <slot name="legend" /> : legend}
        {required && <span class="x-field__required" aria-hidden="true">*</span>}
      </legend>
    )
  }
  <div class="x-choice-group__options"><slot /></div>
  {
    hasDescription && (
      <p class="x-field__help" id={ids.help}>
        {Astro.slots.has('description') ? <slot name="description" /> : description}
      </p>
    )
  }
  {
    hasError && (
      <p class="x-field__error" id={ids.error}>
        {Astro.slots.has('error') ? <slot name="error" /> : error}
      </p>
    )
  }
</fieldset>
