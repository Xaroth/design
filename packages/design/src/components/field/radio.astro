---
import './field.scss'
import type { HTMLAttributes } from 'astro/types'
import { choiceClass } from './index.ts'

type Props = Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'role'> & {
  class?: string
}

const { class: className, ...rest } = Astro.props
const input = { ...rest, type: 'radio' as const, class: 'x-radio__input' }
---

<label class={choiceClass('radio', { className })}>
  <input {...input} />
  <span class="x-radio__label"><slot /></span>
</label>
