---
import './field.scss'
import type { HTMLAttributes } from 'astro/types'
import { textareaClass } from './index.ts'

type Props = Omit<HTMLAttributes<'textarea'>, 'class' | 'value'> & {
  /** Initial text. The default slot works too. */
  value?: string
  defaultValue?: string
  class?: string
}

const { value, defaultValue, class: className, ...rest } = Astro.props
const text = value ?? defaultValue
const attrs = { ...rest, class: textareaClass({ className }) }
---

{
  text === undefined ? (
    <textarea {...attrs}><slot /></textarea>
  ) : (
    <textarea {...attrs}>{text}</textarea>
  )
}
