---
import './field.scss'
import type { HTMLAttributes } from 'astro/types'
import { choiceClass } from './index.ts'

type Props = Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'role'> & {
  class?: string
}

const { class: className, ...rest } = Astro.props
const input = { ...rest, type: 'checkbox' as const, role: 'switch' as const, class: 'x-switch__input' }
---

<label class={choiceClass('switch', { className })}>
  <input {...input} />
  <span class="x-switch__label"><slot /></span>
</label>
