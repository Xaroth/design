---
import './field.scss'
import type { HTMLAttributes } from 'astro/types'
import { selectClass } from './index.ts'

type Props = Omit<HTMLAttributes<'select'>, 'class'> & {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<select {...{ ...rest, class: selectClass({ className }) }}><slot /></select>
