---
import './filters.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  filterClasses as c,
  filterLayoutClass,
  filterPositions,
  filterSwitchButtonAttrs,
  filterSwitchLabels,
  filterSwitchScript,
  type FilterLayoutOptions,
} from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class'> &
  Omit<FilterLayoutOptions, 'className'> & {
    class?: string
    /** Adds a Top / Side switch above the filters (hidden below 1024px). Uses a tiny inline script. */
    switchable?: boolean
    switchLabel?: string
    /** Below 1024px the filters fold behind a closed disclosure. */
    collapsible?: boolean
    collapsibleLabel?: string
    /** Number of active filters, shown on the disclosure. */
    activeCount?: number
    activeLabel?: string
  }

const {
  position = 'top',
  switchable,
  switchLabel = 'Filter position',
  collapsible,
  collapsibleLabel = 'Filters',
  activeCount,
  activeLabel = 'active',
  class: className,
  ...rest
} = Astro.props
---

<div class={filterLayoutClass({ position, className })} {...rest}>
  {
    switchable && (
      <fieldset class={c.switch}>
        <legend class={c.switchLabel}>{switchLabel}</legend>
        <span class={c.switchOptions}>
          {filterPositions.map((option) => (
            <button type="button" {...filterSwitchButtonAttrs(option, position)}>{filterSwitchLabels[option]}</button>
          ))}
        </span>
      </fieldset>
    )
  }
  {
    collapsible && (
      <details class={c.disclosure}>
        <summary class={c.toggle}>
          {collapsibleLabel}
          {activeCount !== undefined && activeCount > 0 && (
            <span class={c.count}>
              {activeCount}
              <span class="x-visually-hidden">{` ${activeLabel}`}</span>
            </span>
          )}
        </summary>
      </details>
    )
  }
  <div class={c.controls}><slot name="filters" /></div>
  <div class={c.results}><slot /></div>
</div>
{switchable && <script is:inline set:html={filterSwitchScript} />}
