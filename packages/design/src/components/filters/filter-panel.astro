---
import './filters.scss'
import type { HTMLAttributes } from 'astro/types'
import { filterPanelClass } from './index.ts'

type Props = Omit<HTMLAttributes<'form'>, 'class'> & {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<form class={filterPanelClass({ className })} {...rest}><slot /></form>
