---
import './breadcrumbs.scss'
import type { HTMLAttributes } from 'astro/types'
import { breadcrumbState, breadcrumbsClass, breadcrumbsClasses as c, type BreadcrumbItem } from './index.ts'

type Props = Omit<HTMLAttributes<'nav'>, 'class'> & {
  class?: string
  items: BreadcrumbItem[]
  label?: string
}

const { class: className, items, label = 'Breadcrumb', slot: _slot, ...rest } = Astro.props
const attrs = { ...rest, 'aria-label': label }
const crumbs = items.map((item, i) => ({ item, ...breadcrumbState(item, i, items.length) }))
---

<nav {...attrs} class={breadcrumbsClass({ className })}>
  <ol class={c.list}>
    {
      crumbs.map(({ item, tag: El, attrs }) => (
        <li class={c.item}>
          <El {...attrs}>{item.label}</El>
        </li>
      ))
    }
  </ol>
</nav>
