---
import '../button/button.scss'
import './header.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  brandState,
  headerClass,
  headerClasses as c,
  navLinkAttrs,
  type HeaderNavItem,
  type HeaderOptions,
} from './index.ts'

type Props = Omit<HTMLAttributes<'header'>, 'class'> &
  Omit<HeaderOptions, 'className'> & {
    class?: string
    items?: HeaderNavItem[]
    brandHref?: string
    /** Accessible name for the brand link. Ignored without `brandHref`. */
    brandLabel?: string
    navLabel?: string
    menuLabel?: string
  }

const {
  layout,
  sticky,
  class: className,
  items = [],
  brandHref,
  brandLabel,
  navLabel = 'Main',
  menuLabel = 'Menu',
  slot: _slot,
  ...rest
} = Astro.props
const { tag: Brand, attrs: brand } = brandState(brandHref, brandLabel)
const actions = Astro.slots.has('actions') ? await Astro.slots.render('actions') : undefined
---

<header {...rest} class={headerClass({ layout, sticky, className })}>
  <div class={c.inner}>
    {
      Astro.slots.has('brand') && (
        <Brand {...brand} class={c.brand}>
          <slot name="brand" />
        </Brand>
      )
    }
    {
      items.length > 0 && (
        <nav class={c.nav} aria-label={navLabel}>
          <ul class={c.list}>
            {items.map((item) => (
              <li class={c.item}>
                <a class={c.link} {...navLinkAttrs(item)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {actions && <div class={c.actions} set:html={actions} />}
    {
      items.length > 0 && (
        <details class={c.menu}>
          <summary class={c.toggle}>
            <span class="x-button__label">{menuLabel}</span>
          </summary>
          <div class={c.panel}>
            <nav aria-label={navLabel}>
              <ul class={c.list}>
                {items.map((item) => (
                  <li class={c.item}>
                    <a class={c.link} {...navLinkAttrs(item)}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      )
    }
  </div>
</header>
