---
import './divider.scss'
import type { HTMLAttributes } from 'astro/types'
import { dividerClass, dividerState, type DividerOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class'> & Omit<DividerOptions, 'className'> & { class?: string }

const { variant, class: className, slot: _slot, ...rest } = Astro.props
const { tag: Tag, attrs: state } = dividerState({ variant })
const attrs = { ...rest, ...state }
---

{
  Tag === 'hr' ? (
    <hr {...rest} class={dividerClass({ variant, className })} />
  ) : (
    <Tag {...attrs} class={dividerClass({ variant, className })}>
      {variant === 'label' ? (
        <span class="x-divider__label">
          <slot />
        </span>
      ) : (
        <span class="x-divider__mark" />
      )}
    </Tag>
  )
}
