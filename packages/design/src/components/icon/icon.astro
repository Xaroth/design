---
import './icon.scss'
import type { HTMLAttributes } from 'astro/types'
import { iconClass, icons, iconState, type IconOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'svg'>, 'class' | 'name' | 'width' | 'height'> & Omit<IconOptions, 'className'> & { class?: string }

const { name, size, label, class: className, slot: _slot, ...rest } = Astro.props
const attrs = {
  ...rest,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  ...iconState({ size, label }),
}
---

<svg {...attrs} class={iconClass({ className })}>{icons[name].map((d) => <path d={d} />)}</svg>
