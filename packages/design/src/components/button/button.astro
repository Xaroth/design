---
import './button.scss'
import type { HTMLAttributes } from 'astro/types'
import { buttonClass, buttonState, type ButtonOptions } from './index.ts'

type Common = Omit<ButtonOptions, 'className'> & { class?: string }

type Props =
  | (Common & Omit<HTMLAttributes<'button'>, 'class'> & { href?: undefined })
  | (Common & Omit<HTMLAttributes<'a'>, 'class' | 'type'> & { href: string; disabled?: boolean; type?: undefined })

const { variant, tone, size, fullWidth, loading, disabled, class: className, href, type, slot: _slot, ...rest } =
  Astro.props
const classes = buttonClass({ variant, tone, size, fullWidth, loading, className })
const { tag: Tag, attrs: state } = buttonState({ href, disabled: Boolean(disabled), loading, type: type ?? undefined })
const attrs = { ...rest, ...state }
---

<Tag {...attrs} class={classes}>
  {
    Astro.slots.has('start') && (
      <span class="x-button__start">
        <slot name="start" />
      </span>
    )
  }
  <span class="x-button__label"><slot /></span>
  {
    Astro.slots.has('end') && (
      <span class="x-button__end">
        <slot name="end" />
      </span>
    )
  }
  {loading && <span class="x-button__spinner" aria-hidden="true" />}
</Tag>
