---
import './stat.scss'
import type { HTMLAttributes } from 'astro/types'
import { statGroupClass, type StatGroupOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'dl'>, 'class'> & Omit<StatGroupOptions, 'className'> & { class?: string }

const { variant, columns, class: className, slot: _slot, ...rest } = Astro.props
---

<dl {...rest} class={statGroupClass({ variant, columns, className })}><slot /></dl>
