---
import './pagination.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  paginationClass,
  paginationClasses as c,
  paginationEntries,
  paginationItemClass,
  paginationPageAttrs,
  type PaginationInput,
  type PaginationOptions,
} from './index.ts'

type Props = Omit<HTMLAttributes<'nav'>, 'class'> &
  Omit<PaginationOptions, 'className'> &
  PaginationInput & {
    class?: string
    /** Accessible name of the nav. */
    label?: string
  }

const {
  align,
  class: className,
  page,
  pages,
  href,
  firstHref,
  siblings,
  ends,
  prevLabel,
  nextLabel,
  firstLabel,
  lastLabel,
  summaryLabel,
  label = 'Pagination',
  ...rest
} = Astro.props
const entries = paginationEntries({
  page,
  pages,
  href,
  firstHref,
  siblings,
  ends,
  prevLabel,
  nextLabel,
  firstLabel,
  lastLabel,
  summaryLabel,
})
---

<nav class={paginationClass({ align, className })} aria-label={label} {...rest}>
  <ul class={c.list}>
    {
      entries.map((entry) => (
        <li class={paginationItemClass(entry)}>
          {entry.kind === 'summary' ? (
            <span class={c.summary}>
              <span aria-hidden="true">{entry.text}</span>
              <span class="x-visually-hidden">{entry.label}</span>
            </span>
          ) : entry.kind === 'page' ? (
            <a class={c.link} {...paginationPageAttrs(entry)}>
              {entry.label}
            </a>
          ) : entry.kind === 'gap' ? (
            <span class={c.gap}>…</span>
          ) : entry.href === undefined ? (
            <span class={c.disabled}>{entry.label}</span>
          ) : (
            <a class={c.edge} href={entry.href} rel={entry.rel}>
              {entry.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
