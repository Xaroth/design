---
import './pagination.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  paginationClass,
  paginationClasses as c,
  paginationEntries,
  paginationPageAttrs,
  type PaginationInput,
  type PaginationOptions,
} from './index.ts'

type Props = Omit<HTMLAttributes<'nav'>, 'class'> &
  Omit<PaginationOptions, 'className'> &
  Omit<PaginationInput, 'href'> & {
    class?: string
    /** URL pattern, {page} is replaced by the page number: '/blog/page/{page}'. */
    href: string
    label?: string
  }

const {
  align,
  class: className,
  page,
  pages,
  href,
  firstHref,
  siblings,
  ends,
  prevLabel,
  nextLabel,
  firstLabel,
  lastLabel,
  label = 'Pagination',
  ...rest
} = Astro.props
const entries = paginationEntries({ page, pages, href, firstHref, siblings, ends, prevLabel, nextLabel, firstLabel, lastLabel })
---

<nav class={paginationClass({ align, className })} aria-label={label} {...rest}>
  <ul class={c.list}>
    {
      entries.map((entry) => (
        <li class={c.item}>
          {entry.kind === 'page' ? (
            <a class={c.link} {...paginationPageAttrs(entry)}>
              {entry.label}
            </a>
          ) : entry.kind === 'gap' ? (
            <span class={c.gap}>…</span>
          ) : entry.href === undefined ? (
            <span class={c.disabled}>{entry.label}</span>
          ) : (
            <a class={c.edge} href={entry.href} rel={entry.rel}>
              {entry.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
