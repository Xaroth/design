---
import './layout.scss'
import type { HTMLAttributes } from 'astro/types'
import { containerClass, type ContainerOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class'> &
  Omit<ContainerOptions, 'className'> & {
    class?: string
    as?: 'div' | 'main' | 'header' | 'footer' | 'article' | 'nav'
  }

const { width, as: Tag = 'div', class: className, slot: _slot, ...rest } = Astro.props
---

<Tag {...rest} class={containerClass({ width, className })}><slot /></Tag>
