---
import './layout.scss'
import type { HTMLAttributes } from 'astro/types'
import Button from '../button/button.astro'
import {
  sectionHeadClass,
  sectionHeadTag,
  type SectionHeadLevel,
  type SectionHeadLink,
} from './index.ts'

type Props = Omit<HTMLAttributes<'header'>, 'class' | 'title'> & {
  class?: string
  title: string
  eyebrow?: string
  sub?: string
  link?: SectionHeadLink
  level?: SectionHeadLevel
  titleId?: string
}

const { title, eyebrow, sub, link, level, titleId, class: className, ...rest } = Astro.props
const Heading = sectionHeadTag(level)
---

<header class={sectionHeadClass({ className })} {...rest}>
  <div class="x-section-head__titles">
    {eyebrow && <p class="x-section-head__eyebrow">{eyebrow}</p>}
    <Heading class="x-section-head__title" id={titleId}>{title}</Heading>
    {sub && <p class="x-section-head__sub">{sub}</p>}
  </div>
  {
    link && (
      <Button class="x-section-head__link" variant="tertiary" size="sm" href={link.href}>
        {link.label}
        <span slot="end" aria-hidden="true">
          →
        </span>
      </Button>
    )
  }
</header>
