---
import './layout.scss'
import type { HTMLAttributes } from 'astro/types'
import { sectionClass, type SectionOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'section'>, 'class'> &
  Omit<SectionOptions, 'className'> & {
    class?: string
    as?: 'section' | 'div' | 'article' | 'aside'
  }

const { tight, as: Tag = 'section', class: className, slot: _slot, ...rest } = Astro.props
---

<Tag {...rest} class={sectionClass({ tight, className })}><slot /></Tag>
