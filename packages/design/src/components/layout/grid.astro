---
import './layout.scss'
import type { HTMLAttributes } from 'astro/types'
import { gridClass } from './index.ts'

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  class?: string
  as?: 'div' | 'main' | 'section' | 'article' | 'ul' | 'ol'
}

const { as: Tag = 'div', class: className, slot: _slot, ...rest } = Astro.props
---

<Tag {...rest} class={gridClass({ className })}><slot /></Tag>
