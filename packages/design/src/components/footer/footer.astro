---
import './footer.scss'
import type { HTMLAttributes } from 'astro/types'
import { footerBrandState, footerClass, footerClasses as c, type FooterGroup, type FooterOptions } from './index.ts'

type Props = Omit<HTMLAttributes<'footer'>, 'class'> &
  Omit<FooterOptions, 'className'> & {
    class?: string
    groups?: FooterGroup[]
    brandHref?: string
    /** Accessible name for the brand link. Ignored without `brandHref`. */
    brandLabel?: string
    /** Legal line. The `note` slot takes precedence. */
    note?: string
    navLabel?: string
  }

const {
  layout,
  class: className,
  groups = [],
  brandHref,
  brandLabel,
  note,
  navLabel = 'Footer',
  slot: _slot,
  ...rest
} = Astro.props
const { tag: Brand, attrs: brand } = footerBrandState(brandHref, brandLabel)
const hasNote = Astro.slots.has('note') || Boolean(note)
---

<footer {...rest} class={footerClass({ layout, className })}>
  <div class={c.inner}>
    {
      Astro.slots.has('brand') && (
        <Brand {...brand} class={c.brand}>
          <slot name="brand" />
        </Brand>
      )
    }
    {
      hasNote && (
        <p class={c.note}>
          <slot name="note">{note}</slot>
        </p>
      )
    }
    {
      groups.length > 0 && (
        <nav class={c.nav} aria-label={navLabel}>
          {groups.map((group) => (
            <div class={c.group}>
              {group.title && <h2 class={c.title}>{group.title}</h2>}
              <ul class={c.links}>
                {group.links.map((link) => (
                  <li>
                    <a class={c.link} href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )
    }
  </div>
</footer>
